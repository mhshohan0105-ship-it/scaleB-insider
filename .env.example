# Copy to .env and fill in.
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/scaleb_insider?schema=public"
AUTH_SECRET="generate-with: npx auth secret"
AUTH_TRUST_HOST=true
APP_URL="http://localhost:3000"

# Dev seed users (agency code "demo"): admin / viewer
SEED_OWNER_PASSWORD="Insider#2026"
SEED_VIEWER_PASSWORD="Viewer#2026"

# Secret for scheduled jobs (e.g. nightly ledger check at /api/cron/ledger-check)
CRON_SECRET="generate-a-long-random-string"

# SMS gateway (optional; without it messages are only logged). Any HTTP gateway:
# {to} {text} {key} {sender} are replaced (URL-encoded). See DEPLOYMENT.md.
SMS_URL_TEMPLATE=""
SMS_METHOD="GET"
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_SUCCESS_REGEX=""
